<!--
    VINTF manifest fragment declaring the boot control HAL for recovery.

    The boot@1.2 service binary and its .rc are present in the recovery ramdisk,
    but without this declaration in the (vendor) VINTF manifest, hwservicemanager
    refuses the registration ("... must be in VINTF manifest"), the service exits,
    and init respawns it every ~5s in a loop. Declaring @1.2 also satisfies
    @1.0/@1.1 clients (HIDL minor-version compatibility), which is what the
    recovery's BootControlClient requests for A/B slot operations.
-->
<manifest version="1.0" type="device">
    <hal format="hidl">
        <name>android.hardware.boot</name>
        <transport>hwbinder</transport>
        <fqname>@1.2::IBootControl/default</fqname>
    </hal>
</manifest>
